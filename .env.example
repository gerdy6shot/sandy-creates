# Required public browser configuration (Vite embeds these at build time).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# Server-side secrets. Never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_ORIGIN=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=
RATE_LIMIT_SALT=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
# Keep off until end-to-end tests and operating approvals complete.
LIVE_INQUIRIES=false
LIVE_CHECKOUT=false
RETAIL_OPERATIONS_APPROVED=false
